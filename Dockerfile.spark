FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir -e . -r requirements-spark.txt
CMD ["python","-m","cdc_lakehouse.job","--input","fixtures/batch1.jsonl","--batch-id","batch1"]
